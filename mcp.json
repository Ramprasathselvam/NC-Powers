{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "jira": {
      "type": "streamable-http",
      "url": "https://mcp.atlassian.com/v1/mcp/authv2"
    },
    "github": {
      "command": "github-mcp-server",
      "args": [
        "stdio"
      ],
      "disabled": false,
      "autoApprove": []
    },
    "figma": {
      "type": "streamable-http",
      "url": "https://mcp.figma.com/mcp"
    }
  }
}
